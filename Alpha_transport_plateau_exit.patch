+       else
+         write(3,*) 'Plateaued at ii=',ii,' error_check=',error_check,' error2=',error2
+       endif
        exit
      endif
    else
-     if (error_check .lt. error_tol) then
-!  JBL: same as above -- emit the regular-format diagnostic line on a
